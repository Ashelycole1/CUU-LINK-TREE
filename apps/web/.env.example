# Base URL of the API. Leave empty: in development Vite proxies /api to
# localhost:4000, and in production the API serves this app on the same origin.
# Only set it if you host the web app separately from the API.
VITE_API_URL=

# Public PostHog browser configuration.
VITE_POSTHOG_KEY=phc_your_project_token
VITE_POSTHOG_HOST=https://your-posthog-host
