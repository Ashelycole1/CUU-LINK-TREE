# The Event Tree server. It answers the API and the public web pages, so the
# app also uses it to build share links. Required for release builds.
#  - Production:               https://<your-app>.onrender.com (or your domain)
#  - iOS simulator / web:      http://localhost:4000
#  - Android emulator:         http://10.0.2.2:4000
#  - Physical phone (Expo Go): http://<your computer's LAN IP>:4000
EXPO_PUBLIC_API_URL=http://localhost:4000
