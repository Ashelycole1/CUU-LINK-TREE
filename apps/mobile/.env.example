# The phone must be able to reach the API.
#  - iOS simulator / web:   http://localhost:4000
#  - Android emulator:      http://10.0.2.2:4000
#  - Physical phone (Expo Go): http://<your computer's LAN IP>:4000
#    (also start the API with PUBLIC_URL set to that address so poster links resolve)
EXPO_PUBLIC_API_URL=http://localhost:4000
