{
  "name": "@event-tree/api",
  "version": "0.1.0",
  "private": true,
  "description": "REST API for Event Tree. Express adapter around @event-tree/core with JSON file storage.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "seed": "tsx src/seed/seed.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@event-tree/core": "0.1.0",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.6",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
