# Port the API listens on
PORT=4000

# Public base URL of this API, used to build links to seeded poster images
PUBLIC_URL=http://localhost:4000

# Where the JSON data files live
DATA_DIR=./data

# Comma-separated origins allowed to call the API ("*" allows any)
CORS_ORIGINS=*

# Optional. When set, creating, editing and deleting events needs the header
#   x-admin-key: <value>
# Reviews and gallery images stay open to everyone.
ADMIN_KEY=
