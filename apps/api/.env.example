# Port the API listens on
PORT=4000

# Public base URL of this API, used to build links to the demo poster images
PUBLIC_URL=http://localhost:4000

# Where the JSON data files live
DATA_DIR=./data

# Comma-separated origins allowed to call the API ("*" allows any)
CORS_ORIGINS=*

# Secret used to sign login tokens. Required in production (NODE_ENV=production).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
