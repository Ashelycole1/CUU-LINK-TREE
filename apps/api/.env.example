# Port the server listens on
PORT=4000

# The address people visit. Required in production (https://...). In
# development it defaults to http://localhost:4000 and builds links to the
# demo poster images.
PUBLIC_URL=

# Postgres connection string: the pooled string from your Neon project
# (Neon console → Connect). Required in production. Leave empty in
# development to keep data in JSON files under DATA_DIR instead.
DATABASE_URL=

# Where the JSON data files live (development only)
DATA_DIR=./data

# Comma-separated origins allowed to call the API. Defaults to "*" in
# development and to PUBLIC_URL in production.
CORS_ORIGINS=

# Secret used to sign login tokens. Required in production (32+ characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
