# Port the server listens on
PORT=4000

# The address people visit. Required in production (https://...). In
# development it defaults to http://localhost:4000 and builds links to the
# demo poster images.
PUBLIC_URL=

# Neon Postgres. `neon deploy` / `neon env pull` writes these to .env.local at
# the repo root, which the API also loads, so you rarely set them here.
# DATABASE_URL is the pooled string (queries); DATABASE_URL_UNPOOLED the direct
# one (creating tables). Required in production. With neither set, development
# keeps data in JSON files under DATA_DIR.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Where the JSON data files live (development only)
DATA_DIR=./data

# Comma-separated origins allowed to call the API. Defaults to "*" in
# development and to PUBLIC_URL in production.
CORS_ORIGINS=

# Neon Auth (sign-in) and Neon Object Storage (uploaded images) are read from
# .env.local at the repo root, which `neon env pull` writes:
#   NEON_AUTH_BASE_URL, NEON_AUTH_JWKS_URL
#   AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_ENDPOINT_URL_S3, AWS_REGION
# Without storage, development keeps uploads in DATA_DIR/media.
# The bucket declared in neon.ts that holds uploads:
MEDIA_BUCKET=assets
